@model Haven.Web.ViewModels.Properties.PropertyDetailsViewModel
@{
    ViewData["Title"] = Model.Listing.Title;
    ViewData["MetaDescription"] = Model.Listing.Description.Length > 180 ? Model.Listing.Description[..180] : Model.Listing.Description;
    var listing = Model.Listing;
}
<section class="page-container">
    <p><a asp-action="Index">Tìm bất động sản</a> / Chi tiết</p>
    <article class="content-card">
        @if (Model.Images.Count > 0)
        {
            <div class="listing-gallery listing-gallery--public" aria-label="Hình ảnh bất động sản">
                @foreach (var image in Model.Images)
                {
                    <img src="/listing-images/@image.Id" alt="Ảnh @listing.Title" loading="lazy" />
                }
    <section class="listing-video-gallery" aria-label="Video bất động sản">
        <h2>Video bất động sản</h2>
        @if (Model.Videos.Count > 0)
        {
            <div class="listing-video-list">
                @foreach (var video in Model.Videos)
                {
                    <video controls preload="metadata" playsinline src="/listing-videos/@video.Id"></video>
                }
            </div>
        }
        else { <p class="is-empty">Tin đăng này chưa có video.</p> }
    </section>
            </div>
        }
        else
        {
            <p class="is-empty">Tin đăng chưa có hình ảnh.</p>
        }
        <p class="muted">@listing.PropertyTypeName · @(listing.Purpose == Haven.Domain.Properties.ListingPurpose.Sale ? "Mua bán" : "Cho thuê")</p>
        <h1>@listing.Title</h1>
        <h2>@listing.PriceAmount.ToString("N0") ₫</h2>
        <p>@listing.AreaSqm.ToString("N1") m² · @listing.District, @listing.Province</p>
        <p>@listing.AddressLine</p>
        @if (listing.Bedrooms is not null || listing.Bathrooms is not null)
        {
            <p>@(listing.Bedrooms?.ToString() ?? "—") phòng ngủ · @(listing.Bathrooms?.ToString() ?? "—") phòng tắm</p>
        }
        <h2>Mô tả</h2>
        <p>@listing.Description</p>
        @if (Model.Owner is { } owner)
        {
            var ownerName = owner.DisplayName;
            var ownerAvatar = new Haven.Web.ViewModels.AvatarViewModel(owner.AvatarPath, ownerName, "medium");
            <a class="listing-owner-link" asp-controller="Members" asp-action="Profile" asp-route-id="@owner.Id">
                <partial name="_Avatar" model="ownerAvatar" />
                <span><small>Người đăng</small><strong>@ownerName</strong><span>Xem hồ sơ</span></span>
            </a>
        }
        else { <p class="muted">Người đăng: @(listing.OwnerDisplayName ?? "Thành viên HAVEN")</p> }
        <div class="property-card__actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (Model.IsFavorite)
                {
                    <form asp-controller="FavoritePages" asp-action="Remove" asp-route-listingId="@listing.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button class="haven-button-secondary" type="submit">Bỏ yêu thích</button>
                    </form>
                }
                else
                {
                    <form asp-controller="FavoritePages" asp-action="Add" asp-route-listingId="@listing.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button class="haven-button-secondary" type="submit">Thêm yêu thích</button>
                    </form>
                }
            }
            else
            {
                <a class="haven-button-secondary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Đăng nhập để yêu thích</a>
            }
            <a class="haven-button-secondary" asp-controller="Properties" asp-action="Compare" asp-route-ids="@listing.Id">So sánh</a>
            <a class="haven-button" asp-controller="ConsultationPages" asp-action="Create" asp-route-listingId="@listing.Id">Yêu cầu tư vấn</a>
        </div>
    </article>
</section>
