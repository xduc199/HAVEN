<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17324d" />
    <title>@(ViewData["Title"] is string title ? $"{title} | HAVEN" : "HAVEN")</title>
    <link rel="icon" type="image/png" href="~/image/logo3.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/frontend.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Haven.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-shell">
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
    <header class="app-header">
        <div class="app-header__inner">
            <a class="app-brand" asp-controller="Home" asp-action="Index"
               aria-label="HAVEN - Trang chủ">
                <span class="app-brand__mark" aria-hidden="true">H</span>
                <span class="app-brand__text">
                    <span class="app-brand__name">HAVEN</span>
                    <span class="app-brand__tagline">Home awaits, vision empowers navigation</span>
                </span>
            </a>

            <nav class="app-nav" aria-label="Điều hướng chính">
                <a class="app-nav__link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a class="app-nav__link" asp-controller="Properties" asp-action="Index">Tìm bất động sản</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="app-nav__link" asp-controller="MyListings" asp-action="Index">Tin của tôi</a>
                    <a class="app-nav__link" asp-controller="FavoritePages" asp-action="Index">Yêu thích</a>
                    <a class="app-nav__link" asp-controller="ConsultationPages" asp-action="Index">Tư vấn</a>
                }
            </nav>

            <div class="app-header__actions">
                @if (User.IsInRole("Admin"))
                {
                    <a class="app-nav__link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="app-header__cta" asp-controller="Account" asp-action="Profile">Tài khoản</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="app-logout-form" data-api-action="logout">
                        @Html.AntiForgeryToken()
                        <div class="api-form-message" data-api-message hidden></div>
                        <button class="app-logout" type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="app-nav__link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a class="app-header__cta" asp-controller="Account" asp-action="Register">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    <main id="main-content" class="app-main" tabindex="-1">
        <div class="app-feedback">
            <partial name="_Feedback" />
        </div>
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="app-footer__inner">
            <a class="app-footer__brand" asp-controller="Home" asp-action="Index">HAVEN</a>
            <p>Khám phá không gian sống phù hợp với bạn.</p>
            <a asp-controller="Home" asp-action="Contact">Liên hệ</a>
            <a asp-controller="Home" asp-action="Privacy">Chính sách riêng tư</a>
            <span class="app-footer__copyright">&copy; @DateTime.Now.Year HAVEN</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/api-forms.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
