<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate">
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
<link rel="icon" type="image/png" href="~/image/logo3.png">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Haven.Web.styles.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true"></script>
</head>

<body>

    <header class="haven-header">
        <div class="container haven-header__inner">

            <a class="haven-brand" asp-controller="Home" asp-action="Index" aria-label="HAVEN - Trang chủ">

                <span class="haven-brand__name">HAVEN</span>

                <span class="haven-brand__tagline">
                    HOME AWAITS, VISION EMPOWERS NAVIGATION
                </span>
            </a>

            <nav class="haven-nav" aria-label="Điều hướng chính">

                <a asp-controller="Home" asp-action="Index">
                    Trang chủ
                </a>

                <a asp-controller="Home" asp-action="MuaBan" class="nav-link">Mua bán</a>


                <a asp-controller="Home" asp-action="ChoThue" class="nav-link">Cho thuê</a>



                <a asp-controller="Home" asp-action="DuAn" class="nav-link">Dự án</a>


                <a href="/Account/Login" class="haven-login-link">
                    Đăng nhập
                </a>

                <a href="/Account/Register" class="haven-register-link">
                    Đăng ký
                </a>

            </nav>

        </div>
    
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Haven.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- HAVEN CUSTOMER CHAT -->
    <div class="haven-chat" id="havenChat">

        <!-- Cửa sổ chat -->
        <section class="haven-chat__window" id="havenChatWindow" aria-label="Chat hỗ trợ HAVEN">

            <!-- Kéo cửa sổ bằng cách giữ phần đầu -->
            <header class="haven-chat__header" id="havenChatDrag">
                <div class="haven-chat__avatar">H</div>

                <div class="haven-chat__heading">
                    <p class="haven-chat__brand">HAVEN</p>
                    <p class="haven-chat__subtitle">
                        Chào mừng bạn! Chúng tôi sẵn sàng hỗ trợ tìm kiếm bất động sản.
                    </p>
                </div>

                <button type="button" class="haven-chat__close" id="havenChatClose"
                        aria-label="Đóng khung chat">×</button>
            </header>

            <div class="haven-chat__body">
                <p class="haven-chat__message">
                    Hãy giới thiệu đôi chút để đội ngũ HAVEN có thể hỗ trợ bạn tốt hơn.
                </p>

                <form class="haven-chat__form" id="havenChatForm">

                    <div class="haven-chat__field">
                        <label for="havenChatName">Họ và tên <span>*</span></label>
                        <input id="havenChatName" name="fullName" type="text" placeholder="Nhập họ và tên"
                               autocomplete="name" required />
                    </div>

                    <div class="haven-chat__field">
                        <label for="havenChatPhone">Số điện thoại <span>*</span></label>
                        <input id="havenChatPhone" name="phone" type="tel" placeholder="Nhập số điện thoại"
                               autocomplete="tel" required />
                    </div>

                    <div class="haven-chat__field">
                        <label for="havenChatEmail">Email</label>
                        <input id="havenChatEmail" name="email" type="email" placeholder="Nhập email"
                               autocomplete="email" />
                    </div>

                    <div class="haven-chat__actions">
                        <button type="submit" class="haven-chat__start">
                            Bắt đầu chat
                        </button>

                        <button type="button" class="haven-chat__cancel" id="havenChatCancel">
                            Hủy
                        </button>
                    </div>
                </form>

                <div class="haven-chat__status" id="havenChatStatus" role="status" aria-live="polite">
                </div>
            </div>
        </section>

        <!-- Nút mở / thu gọn -->
        <button type="button" class="haven-chat__toggle" id="havenChatToggle" aria-label="Mở khung chat"
                aria-expanded="false" title="Chat với HAVEN">
            <span id="havenChatToggleIcon" aria-hidden="true">☏</span>
        </button>

    </div>
    <!-- HAVEN: DẢI TRANG TRÍ CUỐI TRANG -->
    <div class="haven-bottom-decoration" aria-hidden="true">
        <svg class="haven-bottom-decoration__art" viewBox="0 0 1440 150" preserveAspectRatio="none"
             xmlns="http://www.w3.org/2000/svg">

            <defs>
                <linearGradient id="havenGold" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#f5df9b" />
                    <stop offset="48%" stop-color="#d4a72c" />
                    <stop offset="100%" stop-color="#f5df9b" />
                </linearGradient>
            </defs>

            <!-- Nền kem -->
            <rect width="1440" height="150" fill="#fff9e8" />

            <!-- Dải vàng uốn lượn -->
            <path d="M0 65
            C180 5 330 35 500 65
            S820 105 1020 65
            S1290 20 1440 5
            L1440 150 L0 150 Z" fill="url(#havenGold)" />

            <!-- Lớp sáng phía trên -->
            <path d="M0 65
            C180 5 330 35 500 65
            S820 105 1020 65
            S1290 20 1440 5" fill="none" stroke="#f9e9b8" stroke-width="4" />

            <!-- Nền vàng nhạt phía dưới -->
            <path d="M0 92
            C200 40 360 75 530 95
            S850 125 1050 85
            S1290 50 1440 30
            L1440 150 L0 150 Z" fill="#e5bd53" opacity=".75" />

            <!-- Đường chân trời thành phố -->
            <g fill="#c5a45a" opacity=".65">
                <rect x="720" y="112" width="18" height="38" />
                <rect x="742" y="98" width="24" height="52" />
                <rect x="770" y="119" width="17" height="31" />
                <rect x="791" y="88" width="27" height="62" />
                <rect x="822" y="106" width="20" height="44" />
                <rect x="847" y="78" width="24" height="72" />
                <rect x="875" y="114" width="18" height="36" />
                <rect x="898" y="94" width="30" height="56" />
                <rect x="933" y="120" width="18" height="30" />
                <rect x="956" y="85" width="26" height="65" />
                <rect x="986" y="105" width="20" height="45" />
                <rect x="1010" y="65" width="24" height="85" />
                <rect x="1038" y="113" width="20" height="37" />
                <rect x="1064" y="92" width="28" height="58" />
                <rect x="1096" y="108" width="18" height="42" />
                <rect x="1119" y="76" width="26" height="74" />
                <rect x="1149" y="116" width="19" height="34" />
                <rect x="1172" y="94" width="29" height="56" />
                <rect x="1205" y="109" width="22" height="41" />
                <rect x="1231" y="83" width="26" height="67" />
                <rect x="1261" y="112" width="19" height="38" />
                <rect x="1285" y="96" width="29" height="54" />
                <rect x="1318" y="73" width="23" height="77" />
                <rect x="1345" y="109" width="22" height="41" />
                <rect x="1371" y="88" width="25" height="62" />
                <rect x="1400" y="102" width="40" height="48" />
            </g>

            <!-- Đỉnh các tòa nhà -->
            <g stroke="#c5a45a" stroke-width="2" opacity=".65">
                <path d="M858 78 L858 59 M854 65 L858 59 L862 65" />
                <path d="M1022 65 L1022 39 M1018 47 L1022 39 L1026 47" />
                <path d="M1132 76 L1132 52 M1128 60 L1132 52 L1136 60" />
                <path d="M1329 73 L1329 48 M1325 56 L1329 48 L1333 56" />
            </g>
        </svg>
    </div>
    <!-- FOOTER HAVEN -->
    <footer class="haven-footer">

        <div class="haven-footer__main">

            <!-- CỘT 1: THƯƠNG HIỆU -->
            <div class="haven-footer__brand">
                <a href="/" class="haven-footer__logo">HAVEN</a>

                <p class="haven-footer__slogan">
                    HOME AWAITS, VISION EMPOWERS NAVIGATION
                </p>

                <div class="haven-footer__gold-line"></div>

                <p class="haven-footer__description">
                    Khám phá không gian sống lý tưởng, kết nối
                    những giá trị bất động sản và kiến tạo tương lai
                    thịnh vượng cùng HAVEN.
                </p>

                <div class="haven-footer__socials">
                    <a href="https://www.facebook.com/" aria-label="Facebook">f</a>
                    <a href="https://www.youtube.com/" aria-label="YouTube">▶</a>
                    <a href="https://www.instagram.com/" aria-label="Instagram">◎</a>
                </div>
            </div>

            <!-- CỘT 2: KHÁM PHÁ -->
            <div class="haven-footer__column">
                <h3>KHÁM PHÁ HAVEN</h3>

                <a href="/">Trang chủ</a>
                <a href="/Home/MuaBan">Mua bán bất động sản</a>
                <a href="/Home/ChoThue">Cho thuê bất động sản</a>
                <a href="/Home/DuAn">Dự án nổi bật</a>
                <a href="/TinDang/Create">Đăng tin bất động sản</a>
            </div>

            <!-- CỘT 3: HỖ TRỢ -->
            <div class="haven-footer__column">
                <h3>HỖ TRỢ KHÁCH HÀNG</h3>

                <a href="/Home/Privacy">Chính sách bảo mật</a>
                <a href="/Home/DieuKhoan">Điều khoản sử dụng</a>
                <a href="/Home/CauHoiThuongGap">Câu hỏi thường gặp</a>
                <a href="/Home/LienHe">Liên hệ với chúng tôi</a>
                <a href="/Home/HoTro">Trung tâm hỗ trợ</a>
            </div>

            <!-- CỘT 4: LIÊN HỆ -->
            <div class="haven-footer__column haven-footer__contact">
                <h3>KẾT NỐI VỚI HAVEN</h3>

                <p>
                    <span class="haven-footer__contact-icon">⌖</span>
                    <span>Công ty Cổ phần HAVEN Real Estate</span>
                </p>

                <p>
                    <span class="haven-footer__contact-icon">⌖</span>
                    <span>Địa chỉ: 104, Đường Lý Tự Trọng , phường Vinh Phú, tỉnh Nghệ An</span>
                </p>

                <p>
                    <span class="haven-footer__contact-icon">&#64;</span>
                    <span>Email: support@haven.vn</span>
                </p>

                <p>
                    <span class="haven-footer__contact-icon">☎</span>
                    <span>Hotline: 1900 1234</span>
                </p>

                <p>
                    <span class="haven-footer__contact-icon">⏰</span>
                    <span>Giờ làm việc: 08:00 - 18:00 (Thứ 2 - Chủ nhật)</span>
                </p>

                <div class="haven-footer__newsletter">
                    <p>Đăng ký nhận thông tin bất động sản mới.</p>

                    <form action="#" method="get">
                        <input type="email" name="email" placeholder="Email của bạn" aria-label="Email của bạn"
                               required />

                        <button type="submit" aria-label="Đăng ký nhận tin">→</button>
                    </form>
                </div>
            </div>

        </div>

        <!-- DÒNG BẢN QUYỀN -->
        <div class="haven-footer__bottom">
            <p>
                © @DateTime.Now.Year HAVEN.
                Bản quyền thuộc về HAVEN.
            </p>

            <p class="haven-footer__bottom-slogan">
                Không gian sống đẳng cấp · Giá trị bền vững
            </p>
        </div>

    </footer>




</body>

</html>
