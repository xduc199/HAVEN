@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi</h1>
<h2 class="text-danger">HAVEN chưa thể xử lý yêu cầu này. Vui lòng thử lại sau.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Hãy lưu mã yêu cầu nếu bạn cần liên hệ bộ phận hỗ trợ.</p>
