@model Haven.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}
<section class="page-container">
    <h1>Tạo tài khoản HAVEN</h1>
    <form method="post" class="haven-form" data-api-action="register">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" role="alert"></div>
        <div class="api-form-message" data-api-message hidden></div>
        <div class="haven-field"><label asp-for="DisplayName">Tên hiển thị</label><input asp-for="DisplayName" autocomplete="name" /><span asp-validation-for="DisplayName"></span></div>
        <div class="haven-field"><label asp-for="Email">Email</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
        <div class="haven-field"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><small>Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small></div>
        <div class="haven-field"><label asp-for="ConfirmPassword">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
        <button class="haven-button" type="submit">Đăng ký</button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
