@model Haven.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
    ViewData["PageShell"] = "auth-shell auth-shell--register";
}

<section class="auth-experience auth-experience--register" aria-labelledby="auth-title">
    <aside class="auth-visual" aria-label="HAVEN — không gian sống, lựa chọn xứng tầm">
        <img class="auth-visual__image" src="~/image/haven-hero.jpg" asp-append-version="true"
             alt="Kiến trúc khu căn hộ ven sông lúc hoàng hôn" fetchpriority="low" decoding="async" />
        <div class="auth-visual__shade" aria-hidden="true"></div>
        <div class="auth-visual__content">
            <partial name="_BrandLogo" model='@("emblem")' />
        </div>
    </aside>

    <div class="auth-panel">
        <div class="auth-panel__top">
            <a class="auth-back-link" asp-controller="Home" asp-action="Index"><span aria-hidden="true">←</span> Trang chủ</a>
        </div>

        <div class="auth-content auth-content--register">
            <p class="auth-eyebrow auth-eyebrow--gold">YOUR JOURNEY BEGINS</p>
            <h1 id="auth-title">Đăng ký tài khoản HAVEN</h1>
            <p class="auth-intro">Tạo tài khoản HAVEN để khám phá và lưu giữ những không gian phù hợp với bạn.</p>

            <form method="post" class="auth-form auth-form--register" data-api-action="register">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="auth-validation-summary" role="alert"></div>
                <div class="api-form-message auth-api-message" data-api-message hidden></div>

                <div class="auth-field">
                    <label asp-for="DisplayName">Tên hiển thị</label>
                    <input asp-for="DisplayName" autocomplete="name" placeholder="Tên của bạn" />
                    <span asp-validation-for="DisplayName" class="auth-field__error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Email">Địa chỉ email</label>
                    <input asp-for="Email" type="email" autocomplete="email" inputmode="email" placeholder="ban@email.com" />
                    <span asp-validation-for="Email" class="auth-field__error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password">Mật khẩu</label>
                    <div class="auth-password">
                        <input asp-for="Password" autocomplete="new-password" placeholder="Tối thiểu 12 ký tự" />
                        <button class="auth-password__toggle" type="button" data-password-toggle aria-controls="Password" aria-pressed="false">Hiện</button>
                    </div>
                    <span asp-validation-for="Password" class="auth-field__error"></span>
                    <small class="auth-field__hint">Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small>
                </div>

                <div class="auth-field">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <div class="auth-password">
                        <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                        <button class="auth-password__toggle" type="button" data-password-toggle aria-controls="ConfirmPassword" aria-pressed="false">Hiện</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="auth-field__error"></span>
                </div>

                <input asp-for="TermsVersion" type="hidden" />
                <input asp-for="PrivacyVersion" type="hidden" />

                <div class="auth-consents">
                    <div class="auth-consent">
                        <input asp-for="AcceptedTerms" required />
                        <div>
                            <label asp-for="AcceptedTerms">Tôi đồng ý với <a asp-controller="Policies" asp-action="Terms">Điều khoản sử dụng</a>.</label>
                            <span asp-validation-for="AcceptedTerms" class="auth-field__error"></span>
                        </div>
                    </div>
                    <div class="auth-consent">
                        <input asp-for="ConsentedPersonalDataProcessing" required />
                        <div>
                            <label asp-for="ConsentedPersonalDataProcessing">Tôi đã đọc <a asp-controller="Policies" asp-action="Privacy">Chính sách quyền riêng tư</a> và đồng ý để HAVEN xử lý dữ liệu cần thiết cho tài khoản, tin đăng và yêu cầu tư vấn.</label>
                            <span asp-validation-for="ConsentedPersonalDataProcessing" class="auth-field__error"></span>
                        </div>
                    </div>
                </div>

                <button class="auth-submit" type="submit">
                    <span data-submit-label>Tạo tài khoản</span>
                    <span class="auth-submit__loading" aria-live="polite">Đang tạo tài khoản…</span>
                </button>
            </form>

            <p class="auth-switch">Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập</a></p>
        </div>

        <div class="auth-panel__footer"><span>© @DateTime.Now.Year HAVEN</span></div>
    </div>
</section>

@section Styles { <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/auth.js" asp-append-version="true"></script> }
