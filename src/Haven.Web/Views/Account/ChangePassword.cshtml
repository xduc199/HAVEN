@model Haven.Web.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<section class="page-container">
    <h1>Đổi mật khẩu</h1>
    <form method="post" class="haven-form" data-api-action="change-password">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" role="alert"></div>
        <div class="api-form-message" data-api-message hidden></div>
        <div class="haven-field"><label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
        <div class="haven-field"><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></div>
        <div class="haven-field"><label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
        <button class="haven-button" type="submit">Cập nhật mật khẩu</button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
