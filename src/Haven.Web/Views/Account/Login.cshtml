@model Haven.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<section class="page-container">
    <h1>Đăng nhập</h1>
    <form method="post" class="haven-form" data-api-action="login">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" role="alert"></div>
        <div class="api-form-message" data-api-message hidden></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="haven-field"><label asp-for="Email">Email</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
        <div class="haven-field"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password"></span></div>
        <div class="haven-field"><label><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label></div>
        <button class="haven-button" type="submit">Đăng nhập</button>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
