@model Haven.Web.ViewModels.PublicProfileViewModel
@{
    ViewData["Title"] = $"Hồ sơ thành viên: {Model.DisplayName}";
    ViewData["MetaDescription"] = $"Tin bất động sản công khai của {Model.DisplayName} trên HAVEN.";
    var avatar = new Haven.Web.ViewModels.AvatarViewModel(Model.AvatarPath, Model.DisplayName, "large");
}
<section class="page-container public-profile-page">
    <header class="public-profile-header">
        <partial name="_Avatar" model="avatar" />
        <div>
            <p class="public-profile-eyebrow">Thành viên HAVEN</p>
            <h1>@Model.DisplayName</h1>
            <p>@Model.TotalCount tin đăng đang công khai</p>
        </div>
    </header>
    <section aria-labelledby="member-listings-heading">
        <h2 id="member-listings-heading">Tin đăng đang công khai</h2>
        @if (Model.Listings.Count == 0)
        {
            <p class="public-profile-empty">Thành viên này hiện chưa có tin đăng công khai.</p>
        }
        else
        {
            <partial name="_PropertyCards" model="Model.Listings" />
            @if (Model.TotalPages > 1)
            {
                <nav class="public-profile-pagination" aria-label="Phân trang tin đăng">
                    @if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)">Trước</a> }
                    <span>Trang @Model.Page / @Model.TotalPages</span>
                    @if (Model.Page < Model.TotalPages) { <a asp-route-page="@(Model.Page + 1)">Tiếp theo</a> }
                </nav>
            }
        }
    </section>
</section>
