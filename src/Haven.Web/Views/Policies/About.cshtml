@{
    ViewData["Title"] = "Giới thiệu HAVEN";
}
<section class="policy-page container py-5">
    <p class="text-uppercase small text-muted">Không gian sống, tìm thấy dễ dàng</p>
    <h1>HAVEN giúp bạn khám phá bất động sản</h1>
    <p>HAVEN cung cấp công cụ đăng tin, tìm kiếm bất động sản, lưu tin yêu thích, so sánh và gửi yêu cầu tư vấn. Nội dung tin do người đăng cung cấp và được kiểm duyệt trước khi công khai.</p>
    <p>HAVEN hiện không thu tiền, ký hợp đồng, xác nhận quyền sở hữu hay thay mặt các bên môi giới bất động sản.</p>
    <a class="haven-button" asp-controller="Properties" asp-action="Index">Khám phá bất động sản</a>
</section>
