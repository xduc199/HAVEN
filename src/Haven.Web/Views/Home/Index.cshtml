
@{
    ViewData["Title"] = "Haven - Không gian sống đẳng cấp";
}

<section class="haven-hero">
    <div class="container">
        <div class="haven-hero__content">

            <p class="haven-hero__eyebrow">
                KHÔNG GIAN SỐNG ĐẲNG CẤP
            </p>

            <h1>
                Tìm nơi bạn muốn gọi là nhà
            </h1>

            <p class="haven-hero__description">
                Khám phá những bất động sản chất lượng,
                không gian sống lý tưởng và cơ hội đầu tư
                phù hợp với bạn.
            </p>

            <a href="/Property"
               class="btn-haven">
                Khám phá bất động sản
            </a>

        </div>
    </div>
</section>
