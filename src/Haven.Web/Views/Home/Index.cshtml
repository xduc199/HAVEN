@model Haven.Web.ViewModels.Properties.HomePageViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="page-container">
    <div class="content-card">
        <p class="muted">HAVEN · BẤT ĐỘNG SẢN</p>
        <h1>Tìm không gian sống phù hợp với bạn</h1>
        <p class="muted">Tìm kiếm các tin đang được duyệt và công khai trên HAVEN.</p>
        <form asp-controller="Properties" asp-action="Index" method="get" class="haven-form haven-form--filters">
            <div class="haven-field">
                <label for="keyword">Từ khóa</label>
                <input id="keyword" name="keyword" maxlength="100" />
            </div>
            <div class="haven-field">
                <label for="purpose">Mục đích</label>
                <select id="purpose" name="purpose">
                    <option value="">Tất cả</option>
                    <option value="Sale">Mua bán</option>
                    <option value="Rent">Cho thuê</option>
                </select>
            </div>
            <div class="haven-field">
                <label for="propertyTypeId">Loại bất động sản</label>
                <select id="propertyTypeId" name="propertyTypeId">
                    <option value="">Tất cả</option>
                    @foreach (var type in Model.PropertyTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </select>
            </div>
            <div class="form-actions">
                <button class="haven-button" type="submit">Tìm kiếm</button>
            </div>
        </form>
    </div>

    <div class="page-heading" style="margin-top:2rem">
        <div>
            <h2>Tin đăng mới nhất</h2>
            <p>Chỉ hiển thị bất động sản đã được duyệt.</p>
        </div>
        <a asp-controller="Properties" asp-action="Index">Xem tất cả</a>
    </div>

    @if (Model.LatestListings.Count == 0)
    {
        <p class="is-empty">Hiện chưa có bất động sản công khai phù hợp.</p>
    }
    else
    {
        <partial name="_PropertyCards" model="Model.LatestListings" />
    }
</section>
