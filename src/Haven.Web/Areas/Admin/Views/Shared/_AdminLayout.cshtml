@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string target) => string.Equals(controller, target, StringComparison.OrdinalIgnoreCase)
        ? " admin-nav__link--active"
        : string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} | HAVEN Quản trị" : "HAVEN Quản trị")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/haven-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-shell">
    <button type="button" class="admin-sidebar-backdrop" aria-label="Đóng menu quản trị" aria-hidden="true" tabindex="-1"></button>
    <aside class="admin-sidebar" id="admin-sidebar">
        <a class="admin-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="admin-brand__mark">H</span><span>HAVEN <small>QUẢN TRỊ</small></span>
        </a>
        <nav class="admin-nav" aria-label="Điều hướng quản trị">
            <a class="admin-nav__link@(Active("Dashboard"))" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-current="@(string.Equals(controller, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Tổng quan</a>
            <a class="admin-nav__link@(Active("Listings"))" asp-area="Admin" asp-controller="Listings" asp-action="Index">Tin đăng</a>
            <a class="admin-nav__link@(Active("Users"))" asp-area="Admin" asp-controller="Users" asp-action="Index">Người dùng</a>
            <a class="admin-nav__link@(Active("PropertyTypes"))" asp-area="Admin" asp-controller="PropertyTypes" asp-action="Index">Loại bất động sản</a>
            <a class="admin-nav__link@(Active("Tags"))" asp-area="Admin" asp-controller="Tags" asp-action="Index">Nhãn</a>
            <a class="admin-nav__link@(Active("Consultations"))" asp-area="Admin" asp-controller="Consultations" asp-action="Index">Yêu cầu tư vấn</a>
            <a class="admin-nav__link@(Active("PrivacyRequests"))" asp-area="Admin" asp-controller="PrivacyRequests" asp-action="Index">Quyền riêng tư và phản ánh</a>
            <a class="admin-nav__link@(Active("Reports"))" asp-area="Admin" asp-controller="Reports" asp-action="Index">Báo cáo</a>
        </nav>
        <a class="admin-back-link" asp-area="" asp-controller="Home" asp-action="Index">← Về website</a>
    </aside>
    <div class="admin-main">
        <header class="admin-header">
            <button type="button" class="admin-menu-toggle" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Mở hoặc thu gọn menu">☰</button>
            <div class="admin-header__identity">
                <span class="admin-role">Quản trị viên</span>
                @await Component.InvokeAsync("AccountAvatar")
            </div>
        </header>
        <main class="admin-content" id="main-content">
            <nav class="admin-breadcrumb" aria-label="Đường dẫn điều hướng">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a>
                <span aria-hidden="true">/</span>
                <span>@ViewData["Title"]</span>
            </nav>
            <partial name="_Feedback" />
            @RenderBody()
        </main>
    </div>
    <script src="~/js/api-forms.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/avatar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
