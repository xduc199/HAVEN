@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string target) => string.Equals(controller, target, StringComparison.OrdinalIgnoreCase)
        ? " admin-nav__link--active"
        : string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} | HAVEN Admin" : "HAVEN Admin")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-shell">
    <aside class="admin-sidebar" id="admin-sidebar">
        <a class="admin-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="admin-brand__mark">H</span><span>HAVEN <small>ADMIN</small></span>
        </a>
        <nav class="admin-nav" aria-label="Điều hướng quản trị">
            <a class="admin-nav__link@(Active("Dashboard"))" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" aria-current="@(string.Equals(controller, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Dashboard</a>
            <a class="admin-nav__link@(Active("Listings"))" asp-area="Admin" asp-controller="Listings" asp-action="Index">Listings</a>
            <a class="admin-nav__link@(Active("PropertyTypes"))" asp-area="Admin" asp-controller="PropertyTypes" asp-action="Index">Property Types</a>
            <a class="admin-nav__link@(Active("Tags"))" asp-area="Admin" asp-controller="Tags" asp-action="Index">Tags</a>
            <a class="admin-nav__link@(Active("Consultations"))" asp-area="Admin" asp-controller="Consultations" asp-action="Index">Consultations</a>
            <a class="admin-nav__link@(Active("Reports"))" asp-area="Admin" asp-controller="Reports" asp-action="Index">Reports</a>
        </nav>
        <a class="admin-back-link" asp-area="" asp-controller="Home" asp-action="Index">← Về website</a>
    </aside>
    <div class="admin-main">
        <header class="admin-header">
            <button type="button" class="admin-menu-toggle" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Mở hoặc thu gọn menu">☰</button>
            <div class="admin-header__identity">
                <span>@(User.Identity?.Name ?? "Admin")</span>
                <span class="admin-role">Admin</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" data-api-action="logout">
                    @Html.AntiForgeryToken()
                    <div class="api-form-message" data-api-message hidden></div>
                    <button class="admin-logout" type="submit">Đăng xuất</button>
                </form>
            </div>
        </header>
        <main class="admin-content" id="main-content">
            <nav class="admin-breadcrumb" aria-label="Breadcrumb">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                <span aria-hidden="true">/</span>
                <span>@ViewData["Title"]</span>
            </nav>
            <partial name="_Feedback" />
            @RenderBody()
        </main>
    </div>
    <script src="~/js/api-forms.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
