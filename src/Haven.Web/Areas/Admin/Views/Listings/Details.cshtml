@model Haven.Application.Listings.ModerationListingDetails
@using Haven.Domain.Properties
@{
    ViewData["Title"] = "Chi tiết kiểm duyệt";
    var listingTags = ViewData["ListingTags"] as IReadOnlyList<Tag> ?? [];
    var availableTags = ViewData["AvailableTags"] as IReadOnlyList<Tag> ?? [];
    var assignableTags = availableTags.Where(tag => listingTags.All(existing => existing.Id != tag.Id)).ToArray();
    var listingImages = ViewData["ListingImages"] as IReadOnlyList<Haven.Application.Listings.ListingImageInfo> ?? [];
    var listingVideos = ViewData["ListingVideos"] as IReadOnlyList<Haven.Application.Listings.ListingVideoInfo> ?? [];
}
<section class="page-container">
    <h1>@Model.Title</h1>
    <article class="content-card">
        <p>Trạng thái: <span class="status-badge">@Model.Status.GetDisplayName()</span></p>
        <p>Owner ID: @Model.OwnerId</p>
        <p>@Model.Purpose.GetDisplayName() · @Model.PriceAmount.ToString("N0") ₫ · @Model.AreaSqm.ToString("N1") m²</p>
        <p>@Model.AddressLine, @Model.District, @Model.Province</p>
        <p>@Model.Description</p>
        <section class="admin-card">
            <h2>Hình ảnh (@listingImages.Count)</h2>
            @if (listingImages.Count > 0)
            {
                <div class="listing-gallery listing-gallery--manage">
                    @foreach (var image in listingImages)
                    {
                        <article class="listing-gallery__item"><img src="/listing-images/@image.Id" alt="Ảnh tin @Model.Title" />
                            @if (image.IsPrimary) { <span class="status-badge">Ảnh đại diện</span> }
                            <div class="property-card__actions">
                                @if (!image.IsPrimary) { <form asp-action="SetPrimaryImage" asp-route-id="@Model.Id" asp-route-imageId="@image.Id" method="post">@Html.AntiForgeryToken()<button class="admin-button" type="submit">Chọn ảnh chính</button></form> }
                                <form asp-action="DeleteImage" asp-route-id="@Model.Id" asp-route-imageId="@image.Id" method="post">@Html.AntiForgeryToken()<button class="admin-button admin-button--danger" type="submit">Xóa ảnh</button></form>
                            </div>
                        </article>
                    }
                </div>
            }
            else { <p class="admin-empty">Tin chưa có ảnh.</p> }
            <form asp-action="UploadImages" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-filter">
                @Html.AntiForgeryToken()
                <label for="admin-listing-images">Thêm ảnh</label><input id="admin-listing-images" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple data-image-preview-input />
                <div class="listing-image-preview" data-image-preview></div>
                <button class="admin-button" type="submit">Tải ảnh lên</button>
            </form>
        </section>
        <section class="admin-card">
            <h2>Video (@listingVideos.Count)</h2>
            @if (listingVideos.Count > 0)
            {
                <div class="listing-video-list">
                    @foreach (var video in listingVideos)
                    {
                        <article class="listing-video-item"><video controls preload="metadata" playsinline src="/listing-videos/@video.Id"></video><p>@video.ContentType · @((video.Length / 1048576d).ToString("N1")) MB</p><form asp-action="DeleteVideo" asp-route-id="@Model.Id" asp-route-videoId="@video.Id" method="post">@Html.AntiForgeryToken()<button class="admin-button admin-button--danger" type="submit">Xóa video</button></form></article>
                    }
                </div>
            }
            else { <p class="admin-empty">Tin chưa có video.</p> }
            <form asp-action="UploadVideos" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-filter">
                @Html.AntiForgeryToken()<label for="admin-listing-videos">Thêm video MP4/WebM (tối đa 3, 100 MB mỗi video)</label><input id="admin-listing-videos" name="videos" type="file" accept="video/mp4,video/webm,.mp4,.webm" multiple data-video-preview-input /><div class="listing-video-preview" data-video-preview></div><button class="admin-button" type="submit">Tải video lên</button>
            </form>
        </section>
        <section class="admin-card">
            <h2>Nhãn</h2>
            @if (listingTags.Count == 0)
            {
                <p class="admin-empty">Tin đăng chưa có nhãn.</p>
            }
            else
            {
                <ul class="admin-tag-list">
                @foreach (var tag in listingTags)
                {
                    <li>
                        <span>@tag.Name</span>
                        <form asp-action="RemoveTag" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Gỡ tag này khỏi listing?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tagId" value="@tag.Id" />
                            <button class="admin-button admin-button--danger" type="submit">Gỡ</button>
                        </form>
                    </li>
                }
                </ul>
            }
            @if (assignableTags.Length > 0)
            {
                <form asp-action="AssignTag" asp-route-id="@Model.Id" method="post" class="admin-filter">
                    @Html.AntiForgeryToken()
                    <label for="tagId">Gắn nhãn</label>
                    <select id="tagId" name="TagId">
                        @foreach (var tag in assignableTags)
                        {
                            <option value="@tag.Id">@tag.Name</option>
                        }
                    </select>
                    <button class="admin-button" type="submit">Gắn</button>
                </form>
            }
            else
            {
                <p class="admin-muted">Không còn tag đang hoạt động để gắn.</p>
            }
        </section>
        @if (Model.Status == Haven.Domain.Properties.ListingStatus.Pending)
        {
            <div class="form-actions">
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Duyệt tin đăng này?');">@Html.AntiForgeryToken()<button class="haven-button" type="submit">Duyệt</button></form>
                <a class="haven-button-secondary" asp-action="Reject" asp-route-id="@Model.Id">Từ chối</a>
            </div>
        }
        @if (Model.Status == Haven.Domain.Properties.ListingStatus.Approved)
        {
            <form asp-action="Hide" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Ẩn tin này khỏi kết quả công khai?');">@Html.AntiForgeryToken()<button class="haven-button-danger" type="submit">Ẩn tin</button></form>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason)){<p class="is-error">Lý do từ chối: @Model.RejectionReason</p>}
    </article>
    <p><a asp-action="Index">Quay lại</a></p>
</section>
@section Scripts { <script src="~/js/listing-images.js" asp-append-version="true"></script> }
