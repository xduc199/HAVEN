@model IReadOnlyList<Haven.Domain.Properties.PropertyType>
@{
    ViewData["Title"] = "Loại bất động sản";
}
<section class="page-container">
    <div class="page-heading"><h1>Loại bất động sản</h1><a class="haven-button" asp-action="Create">Thêm loại</a></div>
    @if (Model.Count == 0)
    {
        <p class="is-empty">Chưa có loại bất động sản.</p>
    }
    else
    {
        <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Tên</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @foreach (var type in Model)
        {
            <tr><td>@type.Name</td><td>@type.SortOrder</td><td>@(type.IsActive ? "Đang hoạt động" : "Đã tắt")</td><td><a asp-action="Edit" asp-route-id="@type.Id">Chỉnh sửa</a></td></tr>
        }
        </tbody></table></div>
    }
</section>
